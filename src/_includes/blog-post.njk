---
layout: base.njk
---

<article style="max-width: 720px; margin: 0 auto; padding: clamp(60px, 10vh, 100px) clamp(20px, 8vw, 40px);">
  <div class="section-eyebrow">Article</div>
  <h1>{{ title }}</h1>
  <p style="color: var(--text-light); font-size: 14px; margin-bottom: 2rem;">
    {{ author }} · {{ date | dateFormat }} · {{ readTime }}
  </p>
  <div class="blog-content" style="line-height: 1.8;">
    {{ content | safe }}
  </div>
</article>
