  <div class="container">
    <div class="about-content">
      <div class="about-text">
        <h2>Why Choose Smile Dental Clinic?</h2>
        <p>At Smile Dental Clinic, we believe every patient deserves exceptional dental care delivered with compassion and expertise. Our team of licensed dental professionals is committed to helping you achieve and maintain a healthy, beautiful smile.</p>
        
        <p>With state-of-the-art equipment and advanced treatment techniques, we provide a full range of dental services tailored to meet your unique needs — whether it's preventive care, restorative treatments, or cosmetic solutions.</p>

        <div class="about-highlights">
          <div class="highlight">
            <h3>Expert Care</h3>
            <p>Experienced, licensed dental professionals</p>
          </div>
          <div class="highlight">
            <h3>Modern Technology</h3>
            <p>Advanced equipment for precise treatments</p>
          </div>
          <div class="highlight">
            <h3>Patient Comfort</h3>
            <p>Caring approach focused on your well-being</p>
          </div>
          <div class="highlight">
            <h3>Comprehensive Care</h3>
            <p>All treatments under one roof</p>
          </div>
        </div>
      </div>

      <div style="text-align: center;">
        <div style="background: linear-gradient(135deg, #0a5c6f 0%, #00a8cc 100%); width: 100%; height: 400px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white;">
          <span style="font-size: 80px;">🦷</span>
        </div>
        <p style="margin-top: calc(var(--spacing-unit) * 3); font-size: 14px; color: var(--text-light);">Professional dental care for the whole family</p>
      </div>
    </div>
  </div>
</section>

<!-- Services Section -->
<section id="services" class="services">
  <div class="container">
    <div class="section-title">
      <h2>Our Services</h2>
      <p>Comprehensive dental treatments designed for your health and comfort</p>
    </div>

    <div class="services-grid">
      {% for service in services %}
      <div class="service-card">
        <div style="font-size: 36px; margin-bottom: calc(var(--spacing-unit) * 2);">
          {% if service.name == "General Dentistry" %}
          📋
          {% elif service.name == "Dental Cleanings" %}
          ✨
          {% elif service.name == "Root Canals" %}
          🔧
          {% elif service.name == "Dental Implants" %}
          🦷
          {% elif service.name == "Orthodontics" %}
          📈
          {% else %}
          💪
          {% endif %}
        </div>
        <h3>{{ service.name }}</h3>
        <p>{{ service.description }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Testimonials Section -->
<section id="testimonials" class="testimonials">
  <div class="container">
    <div class="section-title">
      <h2>What Our Patients Say</h2>
      <p>Real experiences from people who trust us with their smiles</p>
    </div>

    <div class="testimonials-grid">
